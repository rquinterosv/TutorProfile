rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contact form: anyone can submit, nobody can read/update/delete from the client.
    // Submissions are read from the Firebase console (or an admin SDK).
    match /contactForm/{docId} {
      // venue/eventDate come from the /music booking form (src/components/music/BookingForm.jsx).
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'timestamp', 'venue', 'eventDate'])
        && request.resource.data.keys().hasAll(['name', 'email', 'topic', 'message', 'timestamp'])
        // Keep in sync with TOPICS in src/components/Form.jsx
        && request.resource.data.topic in ['general', 'development', 'consulting', 'music']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp == request.time
        && (!('venue' in request.resource.data)
            || (request.resource.data.venue is string
                && request.resource.data.venue.size() > 0
                && request.resource.data.venue.size() <= 200))
        && (!('eventDate' in request.resource.data)
            || (request.resource.data.eventDate is string
                && request.resource.data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
